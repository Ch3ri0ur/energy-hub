# energy-hub environment variables
# Copy to .env and fill in your secrets (chmod 600 .env).
# These override values in config.yaml.
#
# Keep it KEY=value, one per line, comments on their own line: the file is also
# read by systemd (EnvironmentFile=), which does not strip inline comments, so
# "PASSWORD=x  # note" would send the literal "x  # note" as the password.

# mosquitto password
EH_MQTT_PASSWORD=change-me
EH_ANKER_USER=your@email.com
EH_ANKER_PASSWORD=your-anker-password
EH_ANKER_COUNTRY=DE
# EH_ALERT_WEBHOOK=https://ntfy.sh/your-topic
