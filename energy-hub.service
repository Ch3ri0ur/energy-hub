[Unit]
Description=Energy Hub — unified energy monitoring
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=chriu
WorkingDirectory=/home/chriu/energy-hub
# --frozen --no-sync: never resolve or install at boot (no network, read-only
# uv cache under ProtectSystem=strict). Run `uv sync --frozen` when deploying.
ExecStart=/home/chriu/.local/bin/uv run --frozen --no-sync --project /home/chriu/energy-hub energy-hub -c /home/chriu/energy-hub/config.yaml
Restart=always
RestartSec=10
# A broken config.yaml exits with 78 (EX_CONFIG); restarting would not help.
RestartPreventExitStatus=78
# Give the hub time to publish the offline health payload and stop the Anker thread.
TimeoutStopSec=20

# Credentials via environment file (not in systemd unit)
EnvironmentFile=-/home/chriu/energy-hub/.env

# State: /var/lib/energy-hub (gas_state.json, see gas.state_file in config.yaml).
# Logs go to the journal (logging.file is empty in config.yaml).
StateDirectory=energy-hub
StateDirectoryMode=0750

# Hardening. The project dir, config and .env are read-only for the service.
NoNewPrivileges=true
ProtectSystem=strict
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
CapabilityBoundingSet=
UMask=0077
# anker-solix-api caches its cloud login token inside its own package directory
# (falls back to a private /tmp otherwise, i.e. a fresh login on every start).
# Both layouts listed; missing paths are ignored (leading "-"). Create the one
# for the installed version: mkdir -p <path>.
ReadWritePaths=-/home/chriu/anker-solix-api/api/authcache
ReadWritePaths=-/home/chriu/anker-solix-api/src/anker_solix_api/authcache

[Install]
WantedBy=multi-user.target
