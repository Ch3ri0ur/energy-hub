[Unit]
Description=Energy Hub — unified energy monitoring
After=network-online.target mosquitto.service
Wants=network-online.target

[Service]
Type=simple
User=chriu
WorkingDirectory=/home/chriu/anker-solix-api/energy-hub
ExecStart=/home/chriu/anker-solix-api/energy-hub/.venv/bin/energy-hub -c /home/chriu/anker-solix-api/energy-hub/config.yaml
Restart=on-failure
RestartSec=10

# Credentials via environment file (not in systemd unit)
EnvironmentFile=-/home/chriu/anker-solix-api/energy-hub/.env

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/home/chriu/anker-solix-api/energy-hub
PrivateTmp=true

[Install]
WantedBy=multi-user.target
